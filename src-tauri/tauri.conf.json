{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fuzz",
  "version": "0.1.0",
  "identifier": "app.fuzz.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "fuzz",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
